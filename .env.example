# PaytmAI VyaparVoice - Environment Configuration Template
# Copy to .env for local overrides. NEVER commit .env (.env is listed in .gitignore).

PORT=8000
HOST=127.0.0.1

# Provider Switches ('auto' enables Sarvam or Groq automatically when the matching API key is set;
# when keys are absent, falls back cleanly to browser Web Speech + deterministic templates)
STT_TTS_PROVIDER=auto
LLM_PROVIDER=auto

# Optional 1-Key Sarvam AI Activation (bulbul:v3 TTS + saaras:v3 STT; leave blank for Web Speech fallback)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Optional Groq Free-Tier Grounded Q&A & Number-Verified Phrasing (leave blank for deterministic templates)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_CALLS_PER_SESSION=20

# Public Cloud Safeguards (automatically forced true when RENDER=true unless PUBLIC_DEPLOY=false locally)
PUBLIC_DEPLOY=false
ISOLATE_VISITORS=true
SESSION_TTL_SECONDS=1800
MAX_ACTIVE_SESSIONS=64
MAX_SESSION_DB_BYTES=2097152
MAX_TOTAL_SESSIONS_BYTES=33554432
ADMIN_TOKEN=
