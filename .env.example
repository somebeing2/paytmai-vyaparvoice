# PaytmAI VyaparVoice - Environment Configuration Template
# Copy to .env for local overrides and fill only the variables you need.
# NEVER commit .env (.env is listed in .gitignore).
# When left empty, built-in defaults from config/default.yaml and config/sarvam.yaml apply.

# Primary & Secondary AI Provider Keys (leave empty for keyless Web Speech + deterministic templates)
SARVAM_API_KEY=
GROQ_API_KEY=

# Sarvam Credit & Call Limits (defaults when empty: global=60, per-session=35, mic=10s)
SARVAM_MAX_CALLS=
SARVAM_SESSION_MAX_CALLS=

# Public Render Deployment Gate & Per-IP Rate Limit (defaults when empty: PUBLIC_DEPLOY=false locally / true on Render, RATE_LIMIT_PER_MINUTE=30)
PUBLIC_DEPLOY=
DEMO_PIN=
DEMO_LIVE_UNLOCKED=
RATE_LIMIT_PER_MINUTE=

# Optional Provider & Runtime Overrides (defaults when empty: STT_TTS_PROVIDER=auto, LLM_PROVIDER=auto, PORT=8000)
STT_TTS_PROVIDER=
LLM_PROVIDER=
GROQ_MODEL=
PREWARMED_ASSETS_DIR=
PROVIDER_CACHE_DB_PATH=
ADMIN_TOKEN=
PORT=
HOST=
