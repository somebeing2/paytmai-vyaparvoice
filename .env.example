# PaytmAI VyaparVoice - Environment Configuration Template
# Copy to .env for local overrides. NEVER commit .env or paste real keys into tracked files.

PORT=8000
HOST=127.0.0.1

# Public Cloud Safeguards (automatically forced true when RENDER=true unless set false locally)
PUBLIC_DEPLOY=false
ADMIN_TOKEN=

# Keyless Sarvam AI Integration (disabled by default; hard-blocked when PUBLIC_DEPLOY=true)
SARVAM_ENABLED=false
SARVAM_LIVE_CALLS_ENABLED=false
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Optional Groq Free-Tier English Grounded Q&A (disabled when PUBLIC_DEPLOY=true)
GROQ_ENABLED=false
GROQ_API_KEY=
